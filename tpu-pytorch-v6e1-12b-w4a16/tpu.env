# Deployment parameters for this rig — the single source of truth.
#
# Read by: mcp-run.sh (which launches the MCP server), server.py (as a fallback
# for any variable not already in the environment), and the Makefile (via
# -include). Change a value here and all three follow. A real environment
# variable always wins over anything set here, so a one-off like
# `GOOGLE_CLOUD_ZONE=us-central1-a make status` still works.
#
# GOOGLE_CLOUD_PROJECT is deliberately NOT set here: this repo is published and
# the project id stays out of git (the same reason .mcp.json is gitignored).
# server.py falls back to `gcloud config get-value project`; pin it by exporting
# the variable or by running `./project-setup.sh . --project <id>`.
#
# Forked from tpu-pytorch-v5e1-12b-w4a16 on 2026-10-21; nothing provisioned or
# measured on v6e-1 from this directory yet.
#
# Zone note: us-east5-a is a v6e flex-start zone per the TPU guide
# (references/tpu-guide.md); us-east5-b, us-central1-a and europe-west4-a are
# the others it lists. Not yet tried from this rig.

GOOGLE_CLOUD_REGION=us-east5
GOOGLE_CLOUD_ZONE=us-east5-a

# Gemma 4 12B, QAT w4a16 compressed-tensors (~7 GB of weights), kept from the
# v5e-1 parent so the two rigs differ only in hardware. A v6e chip's 32 GB HBM
# would also hold the bf16 build; that would be a different rig (no slot 5).
MODEL_NAME=google/gemma-4-12B-it-qat-w4a16-ct
ACCELERATOR_TYPE=v6e-1
TENSOR_PARALLEL_SIZE=1

# tpu_openai_server.py — the static-shape PyTorch decode server the VM runs.
# SERVE_SEQ is the fixed [1, SEQ] buffer: prompt + generation must fit inside it,
# and because the compiled step attends over the whole buffer every token, cost
# per step grows with it. 1024 is the v5e-1 parent's balance point; untuned on v6e.
SERVE_PORT=8000
SERVE_SEQ=1024
