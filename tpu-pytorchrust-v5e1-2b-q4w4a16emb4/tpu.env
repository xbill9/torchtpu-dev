# Deployment parameters for this rig — the single source of truth.
#
# Read by: mcp-run.sh (which launches the MCP server), server.py (as a fallback
# for any variable not already in the environment), and the Makefile (via
# -include). A real environment variable always wins over anything set here.
#
# GOOGLE_CLOUD_PROJECT is deliberately NOT set here: this repo is published and
# the project id stays out of git. server.py falls back to
# `gcloud config get-value project`.
#
# Forked from tpu-pytorch-v5e1-2b-w4a16 on 2026-11-02. The model is Rust
# (rust/, a PyO3 extension over a small ATen shim), not Python.

GOOGLE_CLOUD_REGION=us-west4
GOOGLE_CLOUD_ZONE=us-west4-a

# The served checkpoint: the QAT Q4_0 W4A16 repack with int4 vocabulary tables.
# The engine reads the linears, config and tokenizer from BASE_REPO and the int4
# tables (model-rest-001.safetensors) from MODEL_NAME.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
BASE_REPO=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text
ACCELERATOR_TYPE=v5e-1
TENSOR_PARALLEL_SIZE=1

# The VM's Python (deadsnakes, no venv) and what it installs from public PyPI. The
# crate builds against whichever torch this installs; 3.14 is the newest Python
# torch_tpu 0.2.0 has wheels for. The Rust channel is in rust/rust-toolchain.toml.
PYTHON_BIN=python3.14
TORCH_PIP_SPEC=torch==2.14.1 torch_tpu==0.2.0 transformers==5.20.2 compressed-tensors==0.19.0 'jinja2>=3.1' huggingface_hub fastapi uvicorn

# rust_openai_server.py. SERVE_CONTEXT is the cache length in tokens (a multiple
# of 256): prompt plus generation must fit inside it. SERVE_READ_EVERY=1 streams
# token by token. SERVE_DEFER_AND_FUSE=1 is TorchTPU's fused mode, the one open to
# a Rust model (torch.compile traces Python).
SERVE_PORT=8000
SERVE_CONTEXT=8192
SERVE_READ_EVERY=1
SERVE_DEFER_AND_FUSE=1
# Firewall tags on the TPU VM: one that opens SERVE_PORT and one that opens SSH.
SERVE_TAGS=http-server,ssh
TPU_QR_NAME=gemma4-rust-qr
